{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PIO: Build Project1",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\pio.exe",
      "args": ["-d", "Project1", "run"],
      "group": "build"
    },
    {
      "label": "PIO: Upload Project1",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\pio.exe",
      "args": ["-d", "Project1", "run", "-t", "upload"]
    },
    {
      "label": "PIO: Monitor Project1",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\pio.exe",
      "args": ["-d", "Project1", "device", "monitor", "-b", "115200"],
      "isBackground": true
    },
    {
