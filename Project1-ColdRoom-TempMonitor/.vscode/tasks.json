{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PIO: Upload Scan",
            "type": "shell",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "esp32dev_scan",
                "-t",
                "upload"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "PIO: Monitor Scan",
            "type": "shell",
            "command": "pio",
            "args": [
                "device",
                "monitor",
                "-e",
                "esp32dev_scan"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "PIO: Flash & Monitor Scan",
            "dependsOrder": "sequence",
            "dependsOn": [
                "PIO: Upload Scan",
                "PIO: Monitor Scan"
            ],
            "problemMatcher": []
        },
        {
            "label": "PIO: Upload App",
            "type": "shell",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "esp32dev_app",
                "-t",
                "upload"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "PIO: Monitor App",
            "type": "shell",
            "command": "pio",
            "args": [
                "device",
                "monitor",
                "-e",
                "esp32dev_app"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "PIO: Flash & Monitor App",
            "dependsOrder": "sequence",
            "dependsOn": [
                "PIO: Upload App",
                "PIO: Monitor App"
            ],
            "problemMatcher": []
        }
    ]
}
